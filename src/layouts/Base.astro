---
import '~/styles/global.css';
import SEO from '~/components/SEO.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import Motion from '~/components/Motion.astro';
import type { Locale } from '~/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  landing?: boolean;
}
const { locale, title, description, noindex = false, landing = false } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <SEO locale={locale} title={title} description={description} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <div class="page">
      <Nav locale={locale} landing={landing} />
      <main>
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
    <Motion />
  </body>
</html>
